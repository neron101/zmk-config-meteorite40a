#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define BASE   0
#define RAISE  1
#define LOWER  2
#define ADJUST 3
#define SCROLL 4

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可。以下は初期値）
        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_zoom: rsr_zoom {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(EQUAL)>;
            ccw-binding = <&kp LC(MINUS)>;
        };
        rsr_lr: rsr_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT>;
            ccw-binding = <&kp LEFT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <12 13>; /* D + F */
            layers = <BASE>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <16 17>; /* J + K */
            layers = <BASE>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <20 21>; /* Z + X */
            layers = <BASE>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>; /* Q + W */
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E        &kp R      &kp T                           &kp Y      &kp U     &kp I      &kp O    &kp P
&kp A      &kp S      &kp D        &kp F      &kp G                           &kp H      &kp J     &kp K      &kp L    &kp MINUS
&kp Z      &kp X      &kp C        &kp V      &kp B      &mkp LCLK &mkp RCLK  &kp N      &kp M     &kp COMMA  &kp DOT  &kp RS(FSLH)
                      &kp LSHFT    &kp LCTRL  &lt RAISE SPACE  &kp LGUI  &lt LOWER RET  &kp BSPC  &kp DEL    &lt SCROLL RBKT
            >;

            sensor-bindings = <&rsr_scrl &rsr_vol>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5                      &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
&kp F11    &kp F12    &kp TAB    &kp ESC    &kp LBKT                    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp C_MUTE
&kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp RBKT  &trans  &trans    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp C_VOL_UP
                      &trans     &trans     &trans    &trans  &trans    &trans     &trans     &kp C_VOL_DN
            >;

            sensor-bindings = <&rsr_lr &rsr_trans>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp N1      &kp N2      &kp N3     &kp N4         &kp N5                        &kp N6    &kp N7    &kp N8    &kp N9       &kp N0
&kp LS(N1)  &kp LS(N2)  &kp LS(N3) &kp LS(N4)     &kp LS(N5)                    &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)
&kp LANG2   &kp LANG1   &kp GRAVE  &kp LS(GRAVE)  &kp EQUAL  &trans  &trans     &kp BSLH  &kp SQT   &kp SEMI  &kp LS(SQT)  &kp LS(SEMI)
                        &trans     &trans         &trans     &trans  &trans     &trans    &trans    &studio_unlock
            >;

            sensor-bindings = <&rsr_zoom &rsr_trans>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                     &bt BT_CLR_ALL  &none  &none  &none  &bootloader
&bt BT_CLR    &none         &none         &none         &none                            &out OUT_TOG    &none  &none  &none  &none
&none         &none         &none         &none         &none         &none  &none       &studio_unlock  &none  &none  &none  &none
                            &trans        &trans        &trans        &trans &trans      &trans          &trans &trans
            >;

            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };
    };
};
